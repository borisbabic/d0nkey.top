<script>
window['nitroAds'].createAd('nitropay-smart-flex-mobile', {
  "format": "smart-flex",
  "placeholderColor": "#b5df30",
  "smartFlexStickyTop": 0,
  "report": {
    "enabled": true,
    "icon": true,
    "wording": "Report Ad",
    "position": "top-right"
  },
  "demo": <%= nitropay_demo?() %>,
  "mediaQuery": "(min-width: 320px) and (max-width: 767px)"
});
</script>

<%!--
  Below title leaderboard, created once with sizes that fit the content column
  - tablet (768px - 1024px): 728x90, 468x60 for the narrowest tablets
  - narrow laptop (1025px - 1279px): 728x90, 970 doesn't fit next to the rail
  - laptop / short screens: 728x90, 970x90, the 970x250 billboard would push content below the fold
  - large, tall screens: 970x250 billboard allowed
--%>
<script>
(function() {
  var matches = function(query) { return window.matchMedia(query).matches; };
  var sizes;
  if (matches("(max-width: 1024px)")) {
    sizes = [["728", "90"], ["468", "60"]];
  } else if (matches("(max-width: 1279px)")) {
    sizes = [["728", "90"]];
  } else if (matches("(min-width: 1440px) and (min-height: 901px)")) {
    sizes = [["728", "90"], ["970", "90"], ["970", "250"]];
  } else {
    sizes = [["728", "90"], ["970", "90"]];
  }
  window['nitroAds'].createAd('nitropay-below-title-leaderboard', {
    "refreshLimit": 0,
    "refreshTime": 30,
    "renderVisibleOnly": false,
    "refreshVisibleOnly": true,
    "demo": <%= nitropay_demo?() %>,
    "sizes": sizes,
    "report": {
      "enabled": true,
      "wording": "Report Ad",
      "position": "top-right"
    },
    "mediaQuery": "(min-width: 768px)"
  });
})();
</script>

