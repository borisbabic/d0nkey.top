<%!--
  Side rails. Widths must match the space reserved by .space-for-ads in app.css
  - laptop (1025px - 1439px): narrow right rail so tables keep enough room
  - desktop (>= 1440px): full 300px right rail
  - wide (>= 1920px): additional narrow left rail
  No rail below 1025px, there is no room to reserve and it would cover content
--%>
<script>
  window['nitroAds'].createAd('nitropay-sticky-side-rail-laptop', {
    "refreshTime": 30,
    "format": "rail",
    "rail": "right",
    "railOffsetTop": 0,
    "railOffsetBottom": 0,
    "railCollisionWhitelist": ["*"],
    "sizes": [["160", "600"], ["120", "600"]],
    "demo": <%= nitropay_demo?() %>,
    "mediaQuery": "(min-width: 1025px) and (max-width: 1439px)",
    "report": {
      "enabled": true,
      "icon": true,
      "wording": "Report Ad",
      "position": "bottom-right"
    }
  });
  window['nitroAds'].createAd('nitropay-sticky-side-rail', {
    "refreshTime": 30,
    "format": "rail",
    "rail": "right",
    "railOffsetTop": 0,
    "railOffsetBottom": 0,
    "railCollisionWhitelist": ["*"],
    "sizes": [["300", "600"], ["160", "600"], ["300", "250"]],
    "demo": <%= nitropay_demo?() %>,
    "mediaQuery": "(min-width: 1440px)",
    "report": {
      "enabled": true,
      "icon": true,
      "wording": "Report Ad",
      "position": "bottom-right"
    }
  });
  window['nitroAds'].createAd('nitropay-sticky-side-rail-left', {
    "refreshTime": 30,
    "format": "rail",
    "rail": "left",
    "railOffsetTop": 0,
    "railOffsetBottom": 0,
    "railCollisionWhitelist": ["*"],
    "sizes": [["160", "600"], ["120", "600"]],
    "demo": <%= nitropay_demo?() %>,
    "mediaQuery": "(min-width: 1920px)",
    "report": {
      "enabled": true,
      "icon": true,
      "wording": "Report Ad",
      "position": "bottom-left"
    }
  });
</script>
