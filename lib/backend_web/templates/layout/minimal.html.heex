<!DOCTYPE html>
<!-- template: minimal.html.heex - chromeless layout (no navbar/footer/ads) for pages meant to
     live in a small popup or Picture-in-Picture window, e.g. the deck tracker self-report form -->
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <%= csrf_meta_tag() %>
    <.live_title>
      <%= assigns[:page_title] || get_in(assigns, [:meta_tags, :title]) || "HSGuru" %>
    </.live_title>
    <link rel="icon" type="image/x-icon" href={Application.fetch_env!(:backend, :favicon)}/>
    <link rel="stylesheet" href={"#{ Routes.static_path(@conn, "/css/app.css") }"}/>
    <script type="module" src={"#{ Routes.static_path(@conn, "/js/app.js") }"}></script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="color-scheme" content="dark"/>
    <link rel="stylesheet" id="theme-stylesheet" href={"#{ Routes.static_path(@conn, "/css/darkly.css") }"}/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/balloon-css/1.2.0/balloon.min.css">
  </head>
  <body class="minimal-layout">
    <main id="main-content" tabindex="-1" role="main">
      <%= @inner_content %>
    </main>
  </body>
</html>
